{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/nubi-ia",
      "destination": "/orby-ia",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
